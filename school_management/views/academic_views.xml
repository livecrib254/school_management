<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Academic years -->
    <record id="view_school_year_list" model="ir.ui.view">
        <field name="name">school.academic.year.list</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_school_year_form" model="ir.ui.view">
        <field name="name">school.academic.year.form</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open Year" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close Year" invisible="state != 'open'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <field name="term_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="next_term_date"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_school_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">school.academic.year</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Terms -->
    <record id="view_school_term_list" model="ir.ui.view">
        <field name="name">school.term.list</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="year_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="next_term_date"/>
            </list>
        </field>
    </record>
    <record id="view_school_term_form" model="ir.ui.view">
        <field name="name">school.term.form</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="year_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="next_term_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_school_term" model="ir.actions.act_window">
        <field name="name">Terms</field>
        <field name="res_model">school.term</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Grade levels -->
    <record id="view_school_level_list" model="ir.ui.view">
        <field name="name">school.grade.level.list</field>
        <field name="model">school.grade.level</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="education_system"/>
                <field name="stage"/>
                <field name="next_level_id"/>
            </list>
        </field>
    </record>
    <record id="action_school_level" model="ir.actions.act_window">
        <field name="name">Grade Levels</field>
        <field name="res_model">school.grade.level</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Subjects -->
    <record id="view_school_subject_list" model="ir.ui.view">
        <field name="name">school.subject.list</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="education_system"/>
                <field name="is_core"/>
            </list>
        </field>
    </record>
    <record id="action_school_subject" model="ir.actions.act_window">
        <field name="name">Subjects &amp; Learning Areas</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Classes -->
    <record id="view_school_class_list" model="ir.ui.view">
        <field name="name">school.class.list</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="level_id"/>
                <field name="year_id"/>
                <field name="class_teacher_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>
    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="level_id"/>
                            <field name="stream"/>
                            <field name="name"/>
                            <field name="year_id"/>
                        </group>
                        <group>
                            <field name="class_teacher_id"/>
                            <field name="capacity"/>
                            <field name="room"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subjects &amp; Teachers" name="subjects">
                            <field name="subject_line_ids">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="teacher_id"/>
                                    <field name="periods_per_week"/>
                                </list>
                            </field>
                        </page>
                        <page string="Students" name="students">
                            <field name="student_ids" readonly="1">
                                <list>
                                    <field name="admission_no"/>
                                    <field name="name"/>
                                    <field name="gender"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_school_class_search" model="ir.ui.view">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="class_teacher_id"/>
                <field name="level_id"/>
                <group>
                    <filter name="group_level" string="Grade Level" context="{'group_by': 'level_id'}"/>
                    <filter name="group_year" string="Academic Year" context="{'group_by': 'year_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
