<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_promote_wizard" model="ir.ui.view">
        <field name="name">school.promote.wizard.form</field>
        <field name="model">school.promote.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="class_id"/>
                    <field name="action_type" widget="radio"/>
                    <field name="target_class_id" invisible="action_type != 'promote'" required="action_type == 'promote'"
                           domain="[('id', '!=', class_id)]"/>
                </group>
                <field name="student_ids">
                    <list>
                        <field name="admission_no"/>
                        <field name="name"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_school_promote" model="ir.actions.act_window">
        <field name="name">Promote Students</field>
        <field name="res_model">school.promote.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_school_rollover_wizard" model="ir.ui.view">
        <field name="name">school.rollover.wizard.form</field>
        <field name="model">school.rollover.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <div invisible="state == 'done'">
                    <p class="text-muted">
                        Each class of the old year is listed with a suggested action. Promoted students
                        move to the class of the next level and same stream in the new year; that class
                        is created if it does not exist yet. Repeaters move to the same level instead.
                    </p>
                    <group>
                        <group>
                            <field name="from_year_id"/>
                            <field name="to_year_id"/>
                        </group>
                        <group>
                            <field name="copy_subjects"/>
                            <field name="archive_old_classes"/>
                            <field name="switch_years"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0"
                              decoration-muted="action == 'skip'" decoration-info="action == 'graduate'">
                            <field name="to_year_id" column_invisible="1"/>
                            <field name="source_class_id" readonly="1" force_save="1"/>
                            <field name="student_count" readonly="1" force_save="1"/>
                            <field name="action"/>
                            <field name="target_level_id" readonly="action != 'promote'" required="action == 'promote'"
                                   options="{'no_create': True}"/>
                            <field name="target_stream" readonly="action != 'promote'"/>
                            <field name="target_class_id" readonly="action != 'promote'" options="{'no_create': True}"
                                   placeholder="Created on apply"/>
                            <field name="creates_class" widget="boolean" readonly="1"/>
                            <field name="repeater_ids" widget="many2many_tags" readonly="action == 'skip'"
                                   options="{'no_create': True}"/>
                        </list>
                    </field>
                </div>
                <div invisible="state != 'done'">
                    <h4>Rollover complete</h4>
                    <field name="summary" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Run Rollover" class="btn-primary"
                            invisible="state == 'done'"
                            confirm="Move all listed students to the new academic year? This updates every class at once."/>
                    <button name="action_view_new_classes" type="object" string="View New Classes" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_school_rollover" model="ir.actions.act_window">
        <field name="name">Year-End Rollover</field>
        <field name="res_model">school.rollover.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

    <record id="view_school_report_card_wizard" model="ir.ui.view">
        <field name="name">school.report.card.wizard.form</field>
        <field name="model">school.report.card.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="class_id"/>
                    <field name="term_id"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate / Refresh" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_school_report_card_wizard" model="ir.actions.act_window">
        <field name="name">Generate Report Cards</field>
        <field name="res_model">school.report.card.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
