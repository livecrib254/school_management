<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_school" model="ir.module.category">
        <field name="name">School</field>
        <field name="sequence">40</field>
    </record>

    <!-- Odoo 19: each privilege is rendered as one selection on the user form. The school
         roles are independent (a teacher can also be the librarian), so each gets its own. -->
    <record id="privilege_school_teaching" model="res.groups.privilege">
        <field name="name">Teaching</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_school"/>
    </record>
    <record id="privilege_school_records" model="res.groups.privilege">
        <field name="name">Admissions &amp; Records</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_school"/>
    </record>
    <record id="privilege_school_fees" model="res.groups.privilege">
        <field name="name">School Fees</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_school"/>
    </record>
    <record id="privilege_school_library" model="res.groups.privilege">
        <field name="name">Library</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_school"/>
    </record>
    <record id="privilege_school_admin" model="res.groups.privilege">
        <field name="name">School Administration</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_school"/>
    </record>

    <record id="group_school_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_school_teaching"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Classes, timetable, attendance, exams, mark entry and report cards.</field>
    </record>

    <record id="group_school_registrar" model="res.groups">
        <field name="name">Registrar</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_school_records"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Admissions, students, guardians, transport and hostel.</field>
    </record>

    <record id="group_school_accountant" model="res.groups">
        <field name="name">Bursar / Accountant</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_school_fees"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Fee structures, term invoice generation and student invoices.</field>
    </record>

    <record id="group_school_librarian" model="res.groups">
        <field name="name">Librarian</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_school_library"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Books and loans.</field>
    </record>

    <record id="group_school_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_school_admin"/>
        <field name="implied_ids" eval="[
            (4, ref('group_school_teacher')),
            (4, ref('group_school_registrar')),
            (4, ref('group_school_accountant')),
            (4, ref('group_school_librarian')),
            (4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Everything, plus configuration, staff and promotion.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Settings administrators automatically manage the school app -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_school_manager'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_school_student_company" model="ir.rule">
        <field name="name">School student: multi-company</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_class_company" model="ir.rule">
        <field name="name">School class: multi-company</field>
        <field name="model_id" ref="model_school_class"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_year_company" model="ir.rule">
        <field name="name">Academic year: multi-company</field>
        <field name="model_id" ref="model_school_academic_year"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_admission_company" model="ir.rule">
        <field name="name">Admission: multi-company</field>
        <field name="model_id" ref="model_school_admission"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_fee_structure_company" model="ir.rule">
        <field name="name">Fee structure: multi-company</field>
        <field name="model_id" ref="model_school_fee_structure"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_report_card_company" model="ir.rule">
        <field name="name">Report card: multi-company</field>
        <field name="model_id" ref="model_school_report_card"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_school_announcement_company" model="ir.rule">
        <field name="name">Announcement: multi-company</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_school_guardian_message_company" model="ir.rule">
        <field name="name">Guardian message: multi-company</field>
        <field name="model_id" ref="model_school_guardian_message"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Teachers only see the guardian conversations they started or send. Group rules are OR-ed,
         so registrars, bursars and administrators (who are also teachers) keep seeing all of them. -->
    <record id="rule_school_guardian_message_teacher" model="ir.rule">
        <field name="name">Guardian message: teachers see their own</field>
        <field name="model_id" ref="model_school_guardian_message"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
    </record>
    <record id="rule_school_guardian_message_office" model="ir.rule">
        <field name="name">Guardian message: school office sees all</field>
        <field name="model_id" ref="model_school_guardian_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_school_registrar')), (4, ref('group_school_accountant')), (4, ref('group_school_manager'))]"/>
    </record>

    <!-- Parent portal: account's own portal rule only shows invoices addressed to the user.
         Portal rules are OR-ed, so these add the fee invoices of every child the user is a
         guardian of, whoever the fee payer is. Rule domains are evaluated as superuser. -->
    <record id="rule_school_invoice_portal_guardian" model="ir.rule">
        <field name="name">Portal: fee invoices of the guardian's children</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('state', 'not in', ('cancel', 'draft')), ('move_type', 'in', ('out_invoice', 'out_refund')), ('student_id.guardian_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_school_invoice_line_portal_guardian" model="ir.rule">
        <field name="name">Portal: fee invoice lines of the guardian's children</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('parent_state', 'not in', ('cancel', 'draft')), ('move_id.move_type', 'in', ('out_invoice', 'out_refund')), ('move_id.student_id.guardian_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
