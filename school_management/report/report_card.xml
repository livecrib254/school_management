<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_card" model="ir.actions.report">
        <field name="name">Report Card</field>
        <field name="model">school.report.card</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_card_document</field>
        <field name="report_file">school_management.report_card_document</field>
        <field name="print_report_name">'Report Card - %s - %s' % (object.student_id.name, object.term_id.display_name)</field>
        <field name="binding_model_id" ref="model_school_report_card"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_card_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="school" t-value="o.company_id or o.env.company"/>
                        <h3 t-if="school.school_name" class="text-center mb-1" t-out="school.school_name"/>
                        <h2 class="text-center mb-4">Learner Progress Report</h2>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td><strong>Name:</strong> <span t-field="o.student_id.name"/></td>
                                <td><strong>Admission No.:</strong> <span t-field="o.student_id.admission_no"/></td>
                            </tr>
                            <tr>
                                <td><strong>Class:</strong> <span t-field="o.class_id.name"/></td>
                                <td><strong>Term:</strong> <span t-out="o.term_id.display_name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Position:</strong>
                                    <span t-if="o.position"><span t-out="o.position"/> out of <span t-out="o.class_size"/></span>
                                </td>
                                <td><strong>Attendance:</strong> <span t-out="'%.0f%%' % o.attendance_percent"/></td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered mt-3">
                            <thead class="table-light">
                                <tr>
                                    <th>Subject / Learning Area</th>
                                    <th class="text-end">Score (%)</th>
                                    <th class="text-center">Grade</th>
                                    <th class="text-center">Points</th>
                                    <th>Performance</th>
                                    <th>Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.subject_id.name"/></td>
                                    <td class="text-end"><span t-out="'%.1f' % line.percentage"/></td>
                                    <td class="text-center"><strong t-out="line.grade"/></td>
                                    <td class="text-center"><span t-out="line.points"/></td>
                                    <td><span t-out="line.descriptor"/></td>
                                    <td><span t-out="line.teacher_comment"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Overall</th>
                                    <th class="text-end"><span t-out="'%.1f' % o.mean_percentage"/></th>
                                    <th class="text-center"><span t-out="o.mean_grade"/></th>
                                    <th class="text-center"><span t-out="o.total_points"/></th>
                                    <th colspan="2"><span t-out="o.mean_descriptor"/></th>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="mt-4" t-if="o.class_teacher_comment">
                            <strong>Class Teacher's Comment:</strong>
                            <p t-out="o.class_teacher_comment"/>
                        </div>
                        <div class="mt-3" t-if="o.principal_comment">
                            <strong>Head Teacher's Comment:</strong>
                            <p t-out="o.principal_comment"/>
                        </div>
                        <p class="mt-4" t-if="o.term_id.next_term_date">
                            <strong>Next term opens:</strong> <span t-field="o.term_id.next_term_date"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
