<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Year and terms -->
    <record id="demo_year_2026" model="school.academic.year">
        <field name="name">2026</field>
        <field name="date_start">2026-01-05</field>
        <field name="date_end">2026-11-27</field>
        <field name="state">open</field>
    </record>
    <record id="demo_term_1" model="school.term">
        <field name="name">Term 1</field>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="date_start">2026-01-05</field>
        <field name="date_end">2026-04-03</field>
        <field name="next_term_date">2026-04-27</field>
    </record>
    <record id="demo_term_2" model="school.term">
        <field name="name">Term 2</field>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="date_start">2026-04-27</field>
        <field name="date_end">2026-08-07</field>
        <field name="next_term_date">2026-08-31</field>
    </record>
    <record id="demo_term_3" model="school.term">
        <field name="name">Term 3</field>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="date_start">2026-08-31</field>
        <field name="date_end">2026-11-27</field>
    </record>

    <!-- Subjects -->
    <record id="demo_subject_math" model="school.subject">
        <field name="name">Mathematics</field><field name="code">MATH</field>
    </record>
    <record id="demo_subject_eng" model="school.subject">
        <field name="name">English</field><field name="code">ENG</field>
    </record>
    <record id="demo_subject_kis" model="school.subject">
        <field name="name">Kiswahili</field><field name="code">KIS</field>
    </record>
    <record id="demo_subject_sci" model="school.subject">
        <field name="name">Integrated Science</field><field name="code">SCI</field>
    </record>
    <record id="demo_subject_ss" model="school.subject">
        <field name="name">Social Studies</field><field name="code">SST</field>
    </record>

    <!-- Teachers -->
    <record id="demo_teacher_1" model="hr.employee">
        <field name="name">Grace Wanjiru</field>
        <field name="school_role_id" ref="staff_role_teacher"/>
        <field name="tsc_number">TSC-100234</field>
        <field name="job_title">Class Teacher</field>
    </record>
    <record id="demo_teacher_2" model="hr.employee">
        <field name="name">Peter Otieno</field>
        <field name="school_role_id" ref="staff_role_teacher"/>
        <field name="tsc_number">TSC-100871</field>
        <field name="job_title">Teacher</field>
    </record>

    <record id="demo_staff_librarian" model="hr.employee">
        <field name="name">Esther Mutua</field>
        <field name="school_role_id" ref="staff_role_librarian"/>
    </record>
    <record id="demo_staff_matron" model="hr.employee">
        <field name="name">Rose Chebet</field>
        <field name="school_role_id" ref="staff_role_matron"/>
    </record>

    <!-- Classes -->
    <record id="demo_class_g4e" model="school.class">
        <field name="level_id" ref="level_g4"/>
        <field name="stream">East</field>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="class_teacher_id" ref="demo_teacher_1"/>
        <field name="capacity">40</field>
    </record>
    <record id="demo_class_f2a" model="school.class">
        <field name="level_id" ref="level_f2"/>
        <field name="stream">A</field>
        <field name="year_id" ref="demo_year_2026"/>
        <field name="class_teacher_id" ref="demo_teacher_2"/>
        <field name="capacity">45</field>
    </record>

    <record id="demo_cs_g4e_math" model="school.class.subject">
        <field name="class_id" ref="demo_class_g4e"/><field name="subject_id" ref="demo_subject_math"/>
        <field name="teacher_id" ref="demo_teacher_1"/>
    </record>
    <record id="demo_cs_g4e_eng" model="school.class.subject">
        <field name="class_id" ref="demo_class_g4e"/><field name="subject_id" ref="demo_subject_eng"/>
        <field name="teacher_id" ref="demo_teacher_2"/>
    </record>
    <record id="demo_cs_g4e_sci" model="school.class.subject">
        <field name="class_id" ref="demo_class_g4e"/><field name="subject_id" ref="demo_subject_sci"/>
        <field name="teacher_id" ref="demo_teacher_1"/>
    </record>
    <record id="demo_cs_f2a_math" model="school.class.subject">
        <field name="class_id" ref="demo_class_f2a"/><field name="subject_id" ref="demo_subject_math"/>
        <field name="teacher_id" ref="demo_teacher_2"/>
    </record>
    <record id="demo_cs_f2a_eng" model="school.class.subject">
        <field name="class_id" ref="demo_class_f2a"/><field name="subject_id" ref="demo_subject_eng"/>
        <field name="teacher_id" ref="demo_teacher_1"/>
    </record>

    <!-- Guardians -->
    <record id="demo_guardian_1" model="res.partner">
        <field name="name">Mary Njeri</field>
        <field name="phone">+254 700 111 222</field>
        <field name="email">mary.njeri@example.com</field>
    </record>
    <record id="demo_guardian_2" model="res.partner">
        <field name="name">James Kamau</field>
        <field name="phone">+254 711 333 444</field>
        <field name="email">james.kamau@example.com</field>
    </record>

    <!-- Students -->
    <record id="demo_student_1" model="school.student">
        <field name="name">Amani Njeri</field>
        <field name="gender">female</field>
        <field name="date_of_birth">2016-03-14</field>
        <field name="class_id" ref="demo_class_g4e"/>
        <field name="state">enrolled</field>
        <field name="guardian_ids" eval="[(0, 0, {
            'partner_id': ref('demo_guardian_1'), 'relation': 'mother',
            'is_primary': True, 'is_fee_payer': True, 'is_emergency': True})]"/>
    </record>
    <record id="demo_student_2" model="school.student">
        <field name="name">Brian Kamau</field>
        <field name="gender">male</field>
        <field name="date_of_birth">2016-07-02</field>
        <field name="class_id" ref="demo_class_g4e"/>
        <field name="state">enrolled</field>
        <field name="guardian_ids" eval="[(0, 0, {
            'partner_id': ref('demo_guardian_2'), 'relation': 'father',
            'is_primary': True, 'is_fee_payer': True, 'is_emergency': True})]"/>
    </record>
    <record id="demo_student_3" model="school.student">
        <field name="name">Cynthia Achieng</field>
        <field name="gender">female</field>
        <field name="date_of_birth">2012-11-21</field>
        <field name="class_id" ref="demo_class_f2a"/>
        <field name="student_type">boarding</field>
        <field name="state">enrolled</field>
        <field name="guardian_ids" eval="[(0, 0, {
            'partner_id': ref('demo_guardian_1'), 'relation': 'guardian',
            'is_primary': True, 'is_fee_payer': True})]"/>
    </record>

    <!-- Fee structure -->
    <record id="demo_fee_structure_g4" model="school.fee.structure">
        <field name="name">Grade 4 - Term Fees</field>
        <field name="level_ids" eval="[(6, 0, [ref('level_g4')])]"/>
        <field name="student_type">all</field>
    </record>
    <record id="demo_fee_line_tuition" model="school.fee.structure.line">
        <field name="structure_id" ref="demo_fee_structure_g4"/>
        <field name="product_id" ref="product_fee_tuition"/>
        <field name="description">Tuition Fee</field>
        <field name="amount">18000</field>
    </record>
    <record id="demo_fee_line_lunch" model="school.fee.structure.line">
        <field name="structure_id" ref="demo_fee_structure_g4"/>
        <field name="product_id" ref="product_fee_lunch"/>
        <field name="description">Lunch / Meals Fee</field>
        <field name="amount">6500</field>
    </record>

    <!-- Library -->
    <record id="demo_book_1" model="school.book">
        <field name="name">Mathematics Activities Grade 4</field>
        <field name="author">KICD</field>
        <field name="subject_id" ref="demo_subject_math"/>
        <field name="copies_total">10</field>
    </record>

    <!-- An exam with a generated mark sheet -->
    <record id="demo_exam_1" model="school.exam">
        <field name="name">Opener Assessment</field>
        <field name="exam_type">cat</field>
        <field name="class_id" ref="demo_class_g4e"/>
        <field name="term_id" ref="demo_term_1"/>
        <field name="date">2026-01-30</field>
    </record>
    <function model="school.exam" name="action_generate_results" eval="[[ref('demo_exam_1')]]"/>
</odoo>
